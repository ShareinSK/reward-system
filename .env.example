PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Client key (legacy name: anon; Dashboard may show it as "publishable")
PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Web Push (same public key as VAPID_PUBLIC_KEY secret on Edge Functions)
# PUBLIC_VAPID_PUBLIC_KEY=BF...

# Used only by Edge Functions (set via `supabase secrets set`)
# GEMINI_API_KEY=your-gemini-api-key
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...
# RESEND_FROM=HeroHabbits <onboarding@resend.dev>
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com
# NOTIFICATION_CRON_SECRET=long-random-string

# GitHub Pages project-site base path (e.g. /reward-app). Leave empty for local/user-site.
# BASE_PATH=/reward-app
