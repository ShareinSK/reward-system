PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Client key (legacy name: anon; Dashboard may show it as "publishable")
PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Used only by the parse-points-log Edge Function (set via `supabase secrets set`)
# GEMINI_API_KEY=your-gemini-api-key

# GitHub Pages project-site base path (e.g. /reward-app). Leave empty for local/user-site.
# BASE_PATH=/reward-app
